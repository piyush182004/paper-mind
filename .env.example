# Copy to apps/api/.env (and services/ml/.env for the ML_SERVICE_TOKEN). Every key is optional.

# --- Node API -------------------------------------------------------------------------
PORT=8080
# Empty = embedded Postgres (PGlite) under ./data. For hosting use a free Neon Postgres URL:
DATABASE_URL=
ML_SERVICE_URL=http://127.0.0.1:8001
# Shared secret between API and ML service (set the same value in both, required in production)
ML_SERVICE_TOKEN=
CORS_ORIGINS=http://localhost:5173

# --- LLM (OpenRouter, backend only — never exposed to the browser) ----------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=particle-ai/particle-1:free
LLM_DAILY_TOKEN_BUDGET=300000

# --- Discovery sources (all free; keys only raise limits) -------------------------------
OPENALEX_API_KEY=
OPENALEX_MAILTO=
